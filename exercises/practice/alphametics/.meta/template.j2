{%- import "generator_macros.j2" as macros -%}
{{ macros.header(solution) }}

  (define suite
    (test-suite "{{ slug }} tests"

{%- for case in cases %}
      (test-equal? {{ case.description | quote }}
                   (sort
                     ({{ case.property_function }} {{ case.given | quote }})
                     string<? #:key car)
                   (sort
                     {{ (case.expected or {}) | quote }}
                     string<? #:key car))
      {{- macros.close_test(loop) }}
{% endfor %}
  (run-tests suite))
