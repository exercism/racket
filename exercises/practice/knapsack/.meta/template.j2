{%- import "generator_macros.j2" as macros -%}
{{ macros.header(solution) }}

  (define suite
    (test-suite
     "{{ slug }} tests"
{%- for case in cases %}
      (test-equal? {{ case.description | quote }}
                   ({{ case.property_function }} {{ case.input.maximumWeight }}
{%- if case.input["items"] %}
                     (list {% for item in case.input["items"] %}{% if not loop.first %}
                       {% endif %}(item {{ item.weight }} {{ item.value }}){% if loop.last %})){% endif %}{% endfor %}
{%- else %} '())
{%- endif %}
                   {{ case.expected }}){{ macros.close_test(loop) }}
{%- endfor %}

  (run-tests suite))
