{%- import "generator_macros.j2" as macros -%}
{{ macros.header(solution) }}

  (define suite
    (test-suite
     "{{ slug }} tests"
{% for case in cases %}
      (test-= {{ case.description | quote }}
              (on-{{ case.input.planet.lower() }} {{ case.input.seconds }})
              {{ case.expected }}
              0.01)
      {{- macros.close_test(loop) }}
{% endfor %}

  (run-tests suite))
