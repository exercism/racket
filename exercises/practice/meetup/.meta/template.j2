{%- import "generator_macros.j2" as macros -%}
#lang racket/base

{{ require_solution }}

(module+ test
  (require rackunit
           rackunit/text-ui
           racket/date)

  (define (make-date year month day)
    (seconds->date (find-seconds 0 0 0 day month year #f) #f))

  (define suite
    (test-suite "{{ slug }} tests"
{%- for case in cases %}
      (test-equal? {{ case.description | quote }}
                   (meetup-day {{ case.input.year }} {{ case.input.month }} '{{ case.input.dayofweek }} '{{ case.input.week }})
                   (make-date {{ case.expected.split("-")[0] | int }} {{ case.expected.split("-")[1] | int }} {{ case.expected.split("-")[2] | int }}))
		   {{- macros.close_test(loop) }}
{% endfor %}

  (run-tests suite))
