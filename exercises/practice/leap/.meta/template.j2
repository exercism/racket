#lang racket/base

{{ require_solution }}

(module+ test
  (require rackunit rackunit/text-ui)

  (define suite
    (test-suite
     "leap tests"
{% for case in cases %}
{%- if case.expected %}
     (test-{{ case.expected | quote }} {{ case.description | quote }}
                (leap-year? {{ case.given | quote }})){% if loop.last %})){% endif %}
{%- else %}
     (test-{{ case.expected | quote }} {{ case.description | quote }}
                 (leap-year? {{ case.given | quote }})){% if loop.last %})){% endif %}
{%- endif %}
{% endfor %}
  (run-tests suite))
